*.key
*.pem

# 📁 النسخ الاحتياطية
backups/
backup_*.json
*.bak
*.backup

# 📄 ملفات JSON اللي فيها بيانات مستخدمين
login_history.json
last_user.json
failed_attempts.json
login_settings.json
license_settings.json
license_records.json

# 🛠️ أدوات التطوير الداخلية — ما تتبعتش للعملاء
license_generator.py
license_generator_gui.py
tools/

# 🐍 بايثون
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.venv/
venv/
env/

# 📦 بناء التطبيق
build/
dist/
*.spec

# 📝 ملفات النظام
.DS_Store
Thumbs.db
desktop.ini

# 📋 ملفات IDE
.vscode/
.idea/
*.sublime-*

# 📝 اللوجز
*.log
app.log

# 🧪 الاختبارات والتغطية
.pytest_cache/
.coverage
htmlcov/


